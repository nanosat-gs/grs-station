# Copie para .env e ajuste. O .env já é ignorado pelo git.

# --- Banco de dados (compartilhado por toda a estação) ---
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=tc_generator

# --- PGAdmin ---
PGADMIN_EMAIL=admin@spacelab.com
PGADMIN_PASSWORD=admin

# --- TC Generator (Flask) ---
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# --- Estação terrestre ---
# ÚNICO lugar para trocar de onde a estação observa: TC Scheduler e Station
# Manager leem estas mesmas variáveis (ver "Localização da estação" no README).
# ATENÇÃO: os valores abaixo são um EXEMPLO (São Paulo). Troque pelas
# coordenadas reais, ou a estação vai apontar a antena para o lugar errado.
# Decimal com PONTO. Depois de trocar: docker compose up -d (sem --build).
GS_NAME=Estação de Teste
GS_LATITUDE_DEG=-23.5505
GS_LONGITUDE_DEG=-46.6333
GS_ALTITUDE_M=760
# Máscara de elevação: abaixo disso não há visada útil (prédios, árvores,
# ruído de RF perto do horizonte).
GS_MIN_ELEVATION_DEG=0

# --- TC Scheduler ---
# Horizonte de planejamento, em horas.
SCHEDULER_HORIZON_HOURS=24
# Replanejar é caro e o resultado muda devagar (TLEs novos a cada poucas horas).
SCHEDULER_REPLAN_INTERVAL_SECONDS=300
# Frequência de atualização da posição corrente dos satélites no banco.
TRACKING_POLL_INTERVAL_SECONDS=30
# API de leitura do plano (satélites, passagens, telecomandos). É por aqui que
# o painel do GRS Manager se serve, no lugar de abrir o banco: o Postgres tem
# um dono só, e quem escreve nele é quem o serve. SCHEDULER_API_ENABLED=0
# desliga a API sem parar o planejamento.
SCHEDULER_API_PORT=5591
SCHEDULER_API_ENABLED=1

# --- Station Manager (apontamento) ---
# Intervalo entre atualizações de apontamento durante uma passagem. Um LEO no
# zênite varia ~1 grau/s, que é a resolução do rotor Rot2Prog (1 pulso/grau).
STATION_POINTING_INTERVAL_SECONDS=1
# Elevação mínima para comandar o rotor. Abaixo disso o satélite está do outro
# lado da Terra e o azimute varia de forma abrupta. Use -90 para exercitar o
# apontamento sem esperar uma passagem real.
STATION_POINTING_MIN_ELEVATION=0

# Idade máxima do TLE em cache, EM MINUTOS, antes de revalidar no CelesTrak.
# O CelesTrak publica elementos novos a cada poucas horas, então um intervalo
# curto não deixa o TLE mais preciso — ele encurta a espera entre a publicação
# e a estação enxergá-la. O botão "Atualizar TLE" no painel (:5590) força a
# revalidação a qualquer momento, sem esperar este prazo — o painel pede, e
# quem vai ao CelesTrak e escreve o cache é o TC Scheduler.
TRACKING_CACHE_MAX_AGE_MINUTES=15

# --- Caminho de dados RX (profile `rx`) ---
# Só valem quando a estação sobe com `docker compose --profile rx up -d`.
# Ver docs/rx-datapath.md.

# ATENÇÃO: valor PROVISÓRIO, pelo mesmo motivo das coordenadas GS_* acima.
# 145.9 MHz é a beacon do FS-1. A modulação do FS-2 está confirmada (2GFSK,
# syncword BA 67 54 7E, NGHam); a FREQUÊNCIA e o BAUD dependem da coordenação
# IARU / do datasheet do TTC2. Trocar antes de qualquer campanha de gravação
# real — captura na frequência errada é ruído gravado com muito capricho.
RX_CENTER_FREQ_HZ=145900000

# 240 kS/s. Dois motivos, e os dois mordem se ignorados:
#   1. O RTL-SDR só aceita 225001–300000 e 900001–3200000 S/s. Pedir 48 kS/s
#      (a constante DEMOD_DEFAULT_SAMPLE_RATE do grs-demodulator) NÃO dá erro:
#      o driver entrega outra taxa, calado.
#   2. 240000 / 4800 = 50 amostras por símbolo, exato — sem resto para o
#      sincronismo de tempo começar com erro de fase.
RX_SAMPLE_RATE_HZ=240000

# 0 = ganho automático (AGC do tuner). Fixar ganho é coisa de depois da
# primeira campanha, com medida na mão.
RX_GAIN=0

# Qual enlace o gravador grava. O nome tem de existir em
# domain/profiles.py do grs-iq-recorder; se não existir, o serviço NÃO sobe.
RECORDER_PROFILE=grs-rx-fs2

# Teto de uma gravação, em segundos. A 240 kS/s são 1,92 MB/s (~115 MB/min):
# o limite existe para que ninguém encha o disco sem perceber. A gravação
# disparada por passagem (AOS/LOS) está fora desta fatia.
RECORDER_MAX_CAPTURE_SECONDS=60

# --- SDR virtual (profile `rxsim`) ---
# Substituto do grs-iq-rx para testar sem hardware. Os dois BINDAM a :5556, e
# por isso vivem em profiles diferentes — não subem juntos.
#
#   docker compose --profile rxsim up -d --build

# Emissores no ar, separados por vírgula: fs2, fm, carrier.
#   fs2      rajadas 2GFSK com enquadramento NGHam (o downlink do FS-2)
#   fm       portadora FM com uma melodia, para o teste de ouvido
#   carrier  portadora pura, para conferir sintonia direto no espectro
SIM_EMITTERS=fs2

# Relação sinal-ruído, em dB. Valores baixos exercitam a tolerância a erro do
# detector de syncword; valores altos isolam defeitos de DSP do ruído.
SIM_SNR_DB=20

# Desvio Doppler de pico a simular, em Hz. 0 desliga. Um LEO em VHF desvia
# ~3,5 kHz; em UHF, ~10 kHz. Com Doppler ligado o sinal varre a banda ao longo
# de SIM_PASS_DURATION, como numa passagem de verdade — e é assim que se vê se
# a correção de sintonia está acompanhando.
SIM_DOPPLER_HZ=0
SIM_PASS_DURATION=600

# Semente do ruído. Fixa de propósito: sem ela, um teste que falha uma vez em
# dez não é investigável.
SIM_SEED=1

# Para onde o demodulador escuta. No profile rxsim o publicador é o simulador.
# RX_IQ_SOURCE=tcp://grs-sdr-sim:5556
