# repos/ guarda os clones dos blocos da estação, cada um com o seu próprio
# .git. Ignorar NÃO é opcional: sem esta linha o git trata cada clone como um
# gitlink e você reinventa submódulos por acidente — exatamente o que este
# repositório existe para evitar.
repos/

.env
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.idea/
.vscode/

# Capturas de IQ são grandes (1,9 MB/s a 240 kS/s) e não entram no git —
# EXCETO as fixtures de teste, que são curtas, sintéticas e versionadas de
# propósito: sem um artefato fixo não há regressão, só re-execução.
*.sigmf-data
*.sigmf-meta
!tests/fixtures/**/*.sigmf-data
!tests/fixtures/**/*.sigmf-meta
