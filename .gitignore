# repos/ guarda os clones dos blocos da estação, cada um com o seu próprio
# .git. Ignorar NÃO é opcional: sem esta linha o git trata cada clone como um
# gitlink e você reinventa submódulos por acidente — exatamente o que este
# repositório existe para evitar.
repos/

.env
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.idea/
.vscode/
